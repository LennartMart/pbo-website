---
import { u } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Periode from '../components/Periode.astro';
import ToernooiKnop from '../components/ToernooiKnop.astro';
import {
  alleToernooien,
  categorieen,
  geboortejarenKort,
  komende,
  laatsteRanking,
  rankingJaar,
  standNaZin,
  statussen,
  tijdlijn,
  volgendeStandZin,
  type Toernooi,
} from '../lib/jeugdcup';
import { routeUrl } from '../lib/toernooi';
import { alleBerichten, categorieNaam } from '../lib/nieuws';
import { dag, dag2, dagMaand, maand, maandKort, plusDagen, weekdag, weekdagDagMaand, lang, vandaag } from '../lib/datum';
import { competitie, mail } from '../data/site';
import { pk as leesPk } from '../lib/pk';

const toernooien = await alleToernooien();
const komend = await komende();

const berichten = await alleBerichten();
// Een bericht dat een beheerder uitlicht, staat bovenaan: in de hero als de jeugdcup geen volgende halte heeft,
// anders als blok eronder. Het staat dan niet nog eens in de lijst.
const uitgelicht = berichten.find((b) => b.data.uitgelicht);
const recentNieuws = berichten.filter((b) => b !== uitgelicht).slice(0, 4);

// De home is statisch, maar moet ook kloppen als er een tijd geen build is: wat van de volgende halte afhangt, staat
// er voor elke halte die nog komt (tijdlijn), en Periode toont het stuk van vandaag.
const momenten = tijdlijn(toernooien).map((m) => ({ ...m, route: m.volgende && routeUrl({ ...m.volgende, bij: m.volgende.club }) }));
// Het lijnplan wisselt per seizoen; binnen een seizoen wisselt per halte enkel de stip (statussen).
// Na de laatste halte staat het uitgelichte bericht in de hero, dan zonder lijnplan.
const metLijn = momenten.filter((m) => m.haltes.length > 1 && (m.volgende || !uitgelicht));
const lijnplannen = [...new Set(metLijn.map((m) => m.seizoen))].map((seizoen) => {
  const lijst = metLijn.filter((m) => m.seizoen === seizoen);
  return { seizoen, haltes: lijst[0].haltes, van: lijst[0].van, tot: lijst.at(-1)!.tot };
});
// Haltes waarvoor je nu kan inschrijven, onder de volgende halte. De strook verdwijnt als de laatste inschrijving sluit.
const inschrijfstroken = momenten
  .filter((m) => m.inschrijven.length > 0)
  .map((m) => {
    const laatste = m.inschrijven.map((t) => t.inschrijvenTot).reduce((a, b) => (b > a ? b : a));
    return { ...m, tot: m.tot && m.tot < laatste ? m.tot : laatste };
  });
// Telefoon: de vier haltes na de volgende.
const daarnaBlokken = momenten.filter((m) => m.daarna.length > 0).map((m) => ({ ...m, daarna: m.daarna.slice(0, 4) }));

const nieuwJaar = (lijst: Toernooi[], i: number) => i > 0 && rankingJaar(lijst[i]) !== rankingJaar(lijst[i - 1]);
const halte = (t: Toernooi) => u(`/jeugd/jeugdcuptour/kalender#halte-${t.id}`);

const ranking = await laatsteRanking();
// Geboortejaren bij de categorieën: die van de lopende ranking, anders van dit jaar.
const categorieJaar = ranking?.jaar ?? Number(vandaag().slice(0, 4));

// Het PK staat op de home zolang een beheerder het aanzet (Vaste pagina's → PK).
const pk = await leesPk();

const voorClubs = [
  { href: competitie.agenda, title: 'Competitieagenda', text: 'De wedstrijden van je ploeg in je eigen agenda', extern: true },
  { href: competitie.uitslagen, title: 'Uitslagen en standen', text: 'Alle reeksen, bij Badminton Vlaanderen', extern: true },
  { href: u('/bestuur#kalender'), title: 'PBO-kalender', text: 'Selectietrainingen, vergaderingen en evenementen' },
  { href: `mailto:${mail.secretariaat}`, title: 'Secretariaat', text: mail.secretariaat },
];
---

<BaseLayout>
  <!-- Volgende halte van de jeugdcuptour, met het hele seizoen als lijn. Zonder volgende halte: het uitgelichte bericht. -->
  <section class="wrap">
    <div class="on-ink overflow-hidden rounded-[28px] bg-ink text-white lg:rounded-panel">
      {
        momenten.map(({ van, tot, volgende, seizoen, route }) => (
          <Periode as="div" van={van} tot={tot} class="px-6 pt-8 pb-7 md:px-10 md:pt-11 lg:px-16 lg:pt-14 lg:pb-12">
            {volgende ? (
              <div class="min-w-0">
                {/* Eerst wanneer, dan wat: de datum in limoen, net als de volgende halte op de lijn eronder. */}
                <h1 class="font-display">
                  <time
                    datetime={volgende.datum}
                    class="num block text-[44px] leading-[0.95] font-extrabold tracking-[-0.03em] text-accent md:text-[64px] lg:text-[80px]"
                  >
                    {weekdag(volgende.datum)} <span class="whitespace-nowrap">{dag(volgende.datum)} {maand(volgende.datum)}</span>
                  </time>
                  <span class="sr-only">: </span>
                  <span class="mt-2 block text-[26px] leading-[1.12] font-bold tracking-[-0.01em] md:mt-3 md:text-[34px] lg:text-[40px]">
                    Victor Jeugdcuptour by&nbsp;PBO
                  </span>
                </h1>
                <p class="mt-3 max-w-[60ch] text-base leading-normal text-mist md:mt-4 md:text-lg">
                  <span class="font-semibold text-white">{volgende.club}</span>
                  {[volgende.sporthal, volgende.start && `vanaf ${volgende.start}`, volgende.prijsuitreiking && 'met prijsuitreiking']
                    .filter(Boolean)
                    .map((x) => ` · ${x}`)
                    .join('')}
                  {/* Zolang inschrijven kan, zegt de knop het; daarna staat het hier. */}
                  {volgende.toernooilink && volgende.inschrijvenTot && (
                    <Periode as="span" van={plusDagen(volgende.inschrijvenTot, 1)}>
                      {' '}
                      · inschrijvingen afgesloten
                    </Periode>
                  )}
                </p>
                {(volgende.toernooilink || route) && (
                  <div class="mt-6 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-3 md:mt-7">
                    {/* Inschrijven, wedstrijden of uitslagen: dezelfde toernooipagina, het label volgt de datum. */}
                    <ToernooiKnop toernooi={volgende} wie={volgende.club} class="btn bg-accent text-ink" />
                    {route && (
                      <a
                        class:list={[
                          'btn',
                          volgende.toernooilink ? 'border-[1.5px] border-white/40 text-white hover:bg-white/5' : 'bg-accent text-ink',
                        ]}
                        href={route}
                        target="_blank"
                        rel="noopener"
                      >
                        <Icon name="route" size={20} stroke={2} />
                        <span>
                          Route<span class="sr-only"> naar {volgende.sporthal ?? volgende.club}</span>
                        </span>
                        <span class="sr-only"> (Google Maps, nieuw venster)</span>
                      </a>
                    )}
                  </div>
                )}
              </div>
            ) : uitgelicht ? (
              <>
                <p class="flex flex-wrap items-center gap-3">
                  <span class="rounded-full bg-accent px-3.5 py-1.5 text-[13px] font-bold tracking-[0.06em] text-ink uppercase">
                    {categorieNaam(uitgelicht.data.category)}
                  </span>
                  <time datetime={uitgelicht.data.date} class="text-[15px] text-mist">
                    {lang(uitgelicht.data.date)}
                  </time>
                </p>
                <h1 class="mt-4 max-w-[24ch] font-display text-[32px] leading-[1.05] font-extrabold tracking-[-0.01em] md:text-[48px] lg:text-[56px]">
                  {uitgelicht.data.kort ?? uitgelicht.data.title}
                </h1>
                <p class="mt-3 max-w-[60ch] text-base leading-normal text-mist md:mt-4 md:text-lg">{uitgelicht.data.excerpt}</p>
                <div class="mt-6 flex flex-col sm:flex-row md:mt-7">
                  <a class="btn bg-accent text-ink" href={u(`/nieuws/${uitgelicht.id}`)}>
                    Lees het bericht <Icon name="pijl" size={20} stroke={2} />
                  </a>
                </div>
              </>
            ) : (
              <>
                <h1 class="font-display">
                  <span class="num block text-[44px] leading-[0.95] font-extrabold tracking-[-0.03em] text-accent md:text-[64px] lg:text-[80px]">
                    {seizoen ? `Seizoen ${seizoen}` : 'Jeugdcuptour'}
                  </span>
                  <span class="sr-only">: </span>
                  <span class="mt-2 block text-[26px] leading-[1.12] font-bold tracking-[-0.01em] md:mt-3 md:text-[34px] lg:text-[40px]">
                    Victor Jeugdcuptour by&nbsp;PBO
                  </span>
                </h1>
                <p class="mt-4 max-w-[54ch] text-base leading-normal text-mist md:text-lg">
                  {seizoen && 'Alle haltes zijn gespeeld. '}De kalender van het volgende seizoen staat hier zodra de data vastliggen.
                </p>
              </>
            )}
          </Periode>
        ))
      }

      <!-- Latere haltes waarvoor je nu kan inschrijven. Elke halte staat er tot en met haar laatste inschrijfdag. -->
      {
        inschrijfstroken.map(({ van, tot, inschrijven, volgende }) => (
          <Periode
            as="section"
            van={van}
            tot={tot}
            class="border-t border-white/10 px-6 pt-5 pb-4 md:px-10 lg:flex lg:items-center lg:gap-12 lg:px-16 lg:py-5"
            aria-labelledby={`inschrijven-${volgende!.id}`}
          >
            {/* Zolang je ook voor de volgende halte nog kan inschrijven (haar eigen knop), staat er "Ook". */}
            <h2 id={`inschrijven-${volgende!.id}`} class="font-display text-lg font-bold lg:shrink-0">
              {volgende!.toernooilink && volgende!.inschrijvenTot ? (
                <>
                  <Periode as="span" tot={volgende!.inschrijvenTot}>
                    Ook inschrijvingen open
                  </Periode>
                  <Periode as="span" van={plusDagen(volgende!.inschrijvenTot, 1)}>
                    Inschrijvingen open
                  </Periode>
                </>
              ) : (
                'Inschrijvingen open'
              )}
            </h2>
            <ul class="mt-1 divide-y divide-white/10 lg:mt-0 lg:flex lg:flex-wrap lg:gap-x-10 lg:divide-y-0">
              {inschrijven.map((t) => (
                <Periode as="li" tot={t.inschrijvenTot}>
                  <a href={t.toernooilink} rel="noopener" class="group flex min-h-16 items-center gap-3.5 py-3">
                    <span class="grid size-10 shrink-0 place-items-center rounded-full border-[1.5px] border-accent/60 text-accent transition-colors group-hover:border-accent group-hover:bg-accent group-hover:text-ink">
                      <Icon name="inschrijven" size={18} stroke={2} />
                    </span>
                    <span class="min-w-0">
                      <span class="block leading-snug">
                        <span class="font-semibold text-white group-hover:underline max-lg:block">{t.club}</span>
                        <span class="text-mist">
                          <span class="max-lg:hidden"> · </span>
                          {weekdagDagMaand(t.datum)}
                        </span>
                      </span>
                      <span class="block text-[15px] leading-snug text-accent">
                        Inschrijven tot {weekdagDagMaand(t.inschrijvenTot)}
                      </span>
                    </span>
                    <span class="sr-only"> (andere website)</span>
                  </a>
                </Periode>
              ))}
            </ul>
          </Periode>
        ))
      }

      <!-- Lijnplan met alle haltes, namen afwisselend boven en onder de lijn. Enkel op desktop: op de telefoon staan de haltes in "Daarna". -->
      {
        lijnplannen.map(({ seizoen, haltes, van, tot }) => (
          <Periode as="div" van={van} tot={tot} class="hidden border-t border-white/10 px-16 pt-4 pb-6 lg:block">
            <h2 class="sr-only">Alle haltes van seizoen {seizoen}</h2>
            <ol class="grid" style={`grid-template-columns: repeat(${haltes.length}, minmax(0, 1fr))`}>
              {haltes.map((t, i) => {
                const boven = i % 2 === 0;
                // Per halte een li per status (later, volgende, gespeeld); Periode toont die van vandaag.
                return statussen(t, toernooien).map(({ status: s, van, tot }) => (
                  <Periode as="li" van={van} tot={tot}>
                    <a
                      href={halte(t)}
                      class="group grid h-full grid-cols-[minmax(0,1fr)] grid-rows-[3.5rem_2rem_3.5rem] justify-items-center rounded-lg text-center"
                    >
                      <span
                        class:list={[
                          'flex w-max max-w-[10.5rem] flex-col leading-tight',
                          boven ? 'row-start-1 self-end pb-1.5' : 'row-start-3 self-start pt-1.5',
                        ]}
                      >
                        <span
                          class:list={[
                            'num text-[15px] font-bold',
                            s === 'volgende' && 'text-accent',
                            s === 'gespeeld' && 'text-mist/75',
                          ]}
                        >
                          {dag(t.datum)} {maandKort(t.datum)}
                        </span>
                        <span
                          class:list={[
                            'text-[13px] group-hover:underline',
                            s === 'volgende' ? 'font-semibold text-white' : s === 'gespeeld' ? 'text-mist/75' : 'text-mist',
                          ]}
                        >
                          {t.club}
                          {s === 'gespeeld' && <span class="sr-only"> (gespeeld)</span>}
                          {s === 'volgende' && <span class="sr-only"> (volgende halte)</span>}
                        </span>
                        {t.prijsuitreiking && <span class="text-xs font-semibold text-accent">prijsuitreiking</span>}
                      </span>
                      <span class="relative row-start-2 flex w-full items-center justify-center justify-self-stretch">
                        {/* Gereden stuk in limoen: links zodra deze halte aan de beurt is, rechts zodra ze gespeeld is. */}
                        {i > 0 && (
                          <span
                            class:list={[
                              'absolute top-1/2 right-1/2 left-0 h-1 -translate-y-1/2',
                              s !== 'later' ? 'bg-accent' : 'bg-white/20',
                            ]}
                          />
                        )}
                        {i < haltes.length - 1 && (
                          <span
                            class:list={[
                              'absolute top-1/2 right-0 left-1/2 h-1 -translate-y-1/2',
                              s === 'gespeeld' ? 'bg-accent' : 'bg-white/20',
                            ]}
                          />
                        )}
                        {nieuwJaar(haltes, i) && (
                          <span class="num absolute top-1/2 left-0 z-10 -translate-x-1/2 -translate-y-1/2 rounded-full bg-ink px-2 text-xs font-bold text-mist">
                            {rankingJaar(t)}
                          </span>
                        )}
                        <span
                          class:list={[
                            'relative rounded-full transition-transform group-hover:scale-125',
                            s === 'gespeeld' && 'size-3.5 bg-accent',
                            s === 'volgende' && 'size-7 border-[5px] border-accent bg-ink',
                            s === 'later' && 'size-3.5 border-2 border-mist bg-ink',
                          ]}
                        />
                      </span>
                    </a>
                  </Periode>
                ));
              })}
            </ol>
          </Periode>
        ))
      }
    </div>
  </section>

  <!-- Uitgelicht bericht, zolang een beheerder het uitlicht (in de hero na de laatste halte) -->
  {
    uitgelicht && komend.length > 0 && (
      <Periode as="section" tot={komend.at(-1)!.datum} class="wrap mt-3 lg:mt-5" aria-labelledby="uitgelicht-titel">
        <div class="grid gap-5 rounded-card bg-paper px-6 py-7 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-10 lg:px-10 lg:py-9">
          <div class="min-w-0">
            <p class="text-[15px] font-semibold text-brand">
              {categorieNaam(uitgelicht.data.category)} · <time datetime={uitgelicht.data.date}>{lang(uitgelicht.data.date)}</time>
            </p>
            <h2 id="uitgelicht-titel" class="mt-1 text-[28px] leading-[1.1] font-extrabold lg:text-4xl">
              {uitgelicht.data.kort ?? uitgelicht.data.title}
            </h2>
            <p class="mt-2 max-w-[60ch] text-[17px] leading-normal text-muted lg:text-lg">{uitgelicht.data.excerpt}</p>
          </div>
          <a class="btn bg-ink text-white" href={u(`/nieuws/${uitgelicht.id}`)}>
            Lees het bericht <Icon name="pijl" size={20} stroke={2} />
          </a>
        </div>
      </Periode>
    )
  }

  <!-- Provinciaal kampioenschap, zolang het aanstaat in het beheer -->
  {
    pk.tonen && (
      <section class="wrap mt-3 lg:mt-5" aria-labelledby="pk-titel">
        <div class="grid gap-5 rounded-card bg-accent-soft px-6 py-7 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-10 lg:px-10 lg:py-9">
          <div class="min-w-0">
            <h2 id="pk-titel" class="text-[28px] leading-[1.1] font-extrabold lg:text-4xl">
              {pk.titel}
            </h2>
            <p class="mt-2 max-w-[60ch] text-[17px] leading-normal lg:text-lg">{pk.zin}</p>
          </div>
          <div class="flex flex-col gap-2.5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6">
            <ToernooiKnop toernooi={pk.toernooi} wie="het PK" class="btn bg-ink text-white" />
            <a href={u('/pk')} class="inline-flex min-h-11 items-center justify-center gap-2 font-semibold text-brand hover:underline">
              Reeksen en uurschema <Icon name="pijl" size={18} stroke={2} />
            </a>
          </div>
        </div>
      </section>
    )
  }

  <div class="wrap mt-3 grid gap-3 lg:mt-5 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-5">
    <!-- Ranking: zoeken op naam of meteen naar een categorie -->
    <section class="rounded-card bg-accent px-6 py-7 lg:px-10 lg:py-9" aria-labelledby="ranking-titel">
      <h2 id="ranking-titel" class="text-[28px] leading-[1.1] font-extrabold lg:text-4xl">
        {ranking ? `Ranking ${ranking.jaar}` : 'Ranking jeugdcuptour'}
      </h2>
      <p class="mt-2 max-w-[48ch] leading-normal text-ink/80">
        {
          ranking ? (
            <>{standNaZin(ranking.laatste)}</>
          ) : (
            <>Er staat nog geen stand online.</>
          )
        }{' '}
        {
          momenten.map(
            ({ van, tot, volgende }) =>
              volgende && (
                <Periode as="span" van={van} tot={tot}>
                  {volgendeStandZin(volgende, ranking?.jaar)}
                </Periode>
              ),
          )
        }
      </p>
      {
        ranking ? (
          <>
            <form action={u('/jeugd/jeugdcuptour/ranking')} method="get" role="search" class="mt-6">
              <label for="home-zoek" class="mb-2 block font-semibold">
                Zoek je naam
              </label>
              <div class="flex gap-2">
                <input
                  id="home-zoek"
                  name="q"
                  type="search"
                  autocomplete="off"
                  placeholder="Voornaam of familienaam"
                  class="min-h-[52px] w-full min-w-0 rounded-full border-[1.5px] border-ink bg-paper px-5 text-base placeholder:text-muted"
                />
                <button type="submit" class="btn shrink-0 bg-ink px-5 text-white">
                  <Icon name="zoek" size={20} stroke={2} />
                  <span class="max-sm:sr-only">Zoek</span>
                </button>
              </div>
            </form>
            <h3 class="mt-7 mb-1 font-sans text-base font-semibold">Of kies je categorie</h3>
            <ul class="grid sm:grid-cols-2 sm:gap-x-8">
              {categorieen.map((c) => (
                <li class="border-t border-ink/15">
                  <a
                    href={`${u('/jeugd/jeugdcuptour/ranking')}?cat=${c.id}`}
                    class="group flex min-h-[52px] items-center justify-between gap-3"
                  >
                    <span>
                      <span class="font-display text-lg font-bold">{c.label}</span>
                      <span class="num ml-2 text-[15px] text-ink/75">geboren {geboortejarenKort(c.id, categorieJaar)}</span>
                    </span>
                    <Icon name="pijl" size={18} stroke={2} class="shrink-0 transition-transform group-hover:translate-x-0.5" />
                  </a>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <a class="btn mt-6 bg-ink text-white" href={u('/jeugd/jeugdcuptour/ranking')}>
            Eerdere standen
          </a>
        )
      }
    </section>

    <!-- Telefoon: de haltes na de volgende, als lijn onder elkaar -->
    {
      daarnaBlokken
        .map(({ van, tot, volgende, daarna }) => (
          <Periode
            as="section"
            van={van}
            tot={tot}
            class="rounded-card bg-paper px-6 pt-7 pb-1 lg:hidden"
            aria-labelledby={`daarna-${volgende!.id}`}
          >
            <h2 id={`daarna-${volgende!.id}`} class="text-[28px] leading-[1.1] font-extrabold">
              Daarna
            </h2>
            <ol class="mt-2">
              {daarna.map((t, i) => {
                const lijst = [volgende!, ...daarna];
                const jaar = nieuwJaar(lijst, i + 1);
                return (
                  <li>
                    {jaar && (
                      <p class="grid min-h-12 grid-cols-[1rem_3rem_minmax(0,1fr)] items-center gap-x-3">
                        <span class="relative self-stretch" aria-hidden="true">
                          <span class="absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-line" />
                        </span>
                        <span class="num text-center font-display text-lg font-extrabold">{rankingJaar(t)}</span>
                        <span class="text-sm text-muted">Vanaf hier telt de ranking {rankingJaar(t)}</span>
                      </p>
                    )}
                    <a href={halte(t)} class="grid min-h-[68px] grid-cols-[1rem_3rem_minmax(0,1fr)] items-center gap-x-3">
                      <span class="relative flex items-center justify-center self-stretch" aria-hidden="true">
                        <span class="absolute top-0 bottom-1/2 left-1/2 w-0.5 -translate-x-1/2 bg-line" />
                        {i < daarna.length - 1 && <span class="absolute top-1/2 bottom-0 left-1/2 w-0.5 -translate-x-1/2 bg-line" />}
                        <span class="relative size-3 rounded-full border-2 border-ink bg-paper" />
                      </span>
                      <time datetime={t.datum} class="text-center">
                        <span class="num block font-display text-[26px] leading-none font-extrabold">{dag2(t.datum)}</span>
                        <span class="block text-xs font-bold text-muted uppercase">{maandKort(t.datum)}</span>
                      </time>
                      <span class="min-w-0 py-3">
                        <span class="block font-semibold">{t.club}</span>
                        <span class="block text-sm text-muted">
                          {[weekdag(t.datum), t.sporthal, t.prijsuitreiking && 'prijsuitreiking'].filter(Boolean).join(' · ')}
                        </span>
                        {t.toernooilink && t.inschrijvenTot && (
                          <Periode as="span" tot={t.inschrijvenTot} class="mt-1 flex items-center gap-1.5 text-sm font-semibold text-brand">
                            <Icon name="inschrijven" size={15} stroke={2.2} /> Inschrijven tot {dagMaand(t.inschrijvenTot)}
                          </Periode>
                        )}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ol>
            <a
              href={u('/jeugd/jeugdcuptour/kalender')}
              class="flex min-h-[56px] items-center justify-between gap-3 border-t border-wash font-semibold"
            >
              Hele kalender <Icon name="pijl" size={18} stroke={2} />
            </a>
          </Periode>
        ))
    }

    <!-- Wat clubs en competitiespelers het vaakst zoeken -->
    <section class="rounded-card bg-paper px-6 pt-7 pb-3 lg:flex lg:flex-col lg:px-10 lg:pt-9" aria-labelledby="clubs-titel">
      <h2 id="clubs-titel" class="text-[28px] leading-[1.1] font-extrabold lg:text-4xl">Voor clubs en competitie</h2>
      <ul class="mt-4 lg:grid lg:flex-1 lg:auto-rows-fr">
        {
          voorClubs.map((l) => (
            <li class="border-b border-wash last:border-b-0">
              <a
                href={l.href}
                class="group flex min-h-[72px] items-center justify-between gap-4 py-3"
                {...(l.extern ? { target: '_blank', rel: 'noopener' } : {})}
              >
                <span class="min-w-0">
                  <span class="block text-lg font-semibold group-hover:text-brand">{l.title}</span>
                  <span class="block text-[15px] [overflow-wrap:anywhere] text-muted">{l.text}</span>
                </span>
                <Icon name={l.extern ? 'extern' : 'pijl'} size={18} stroke={2} class="shrink-0 text-muted group-hover:text-brand" />
                {l.extern && <span class="sr-only">(andere website, nieuw venster)</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <!-- Nieuws -->
  <section class="wrap mt-12 lg:mt-20" aria-labelledby="nieuws-titel">
    <h2 id="nieuws-titel" class="mb-3 px-2 text-[28px] leading-[1.1] font-extrabold lg:mb-5 lg:px-0 lg:text-4xl">Nieuws</h2>
    <div class="rounded-card bg-paper p-2 lg:p-3">
      <ol>
        {
          recentNieuws.map((n, i) => (
            <li class:list={['border-b border-wash', i > 2 && 'max-lg:hidden']}>
              <a
                href={u(`/nieuws/${n.id}`)}
                class="group grid gap-1 rounded-2xl px-4 py-4 transition-colors hover:bg-ground lg:grid-cols-[11rem_minmax(0,1fr)] lg:gap-6 lg:px-6 lg:py-5"
              >
                <time datetime={n.data.date} class="num text-sm font-semibold text-brand lg:pt-1 lg:text-[15px]">
                  {lang(n.data.date)}
                </time>
                <span class="min-w-0">
                  <span class="block font-display text-xl leading-[1.2] font-bold group-hover:underline lg:text-[22px]">
                    {n.data.title}
                  </span>
                  {i === 0 && <span class="mt-1.5 line-clamp-2 block max-w-[68ch] text-muted">{n.data.excerpt}</span>}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <a
        href={u('/nieuws')}
        class="flex min-h-[56px] items-center justify-between gap-3 rounded-2xl px-4 font-semibold hover:bg-ground lg:px-6"
      >
        Alle berichten
        <Icon name="pijl" size={18} stroke={2} />
      </a>
    </div>
  </section>
</BaseLayout>
