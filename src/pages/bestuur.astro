---
import { u } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import LinkCard from '../components/LinkCard.astro';
import PersonCard from '../components/PersonCard.astro';
import Icon from '../components/Icon.astro';
import { mail, pboKalenderEmbed } from '../data/site';
import { pagina } from '../lib/paginas';

const { title, lead, description, bestuurders, medewerkers, bijdragen, documenten, Content } = await pagina('bestuur');
---

<BaseLayout title={title} description={description}>
  <PageIntro title={title} lead={lead} />

  <section class="wrap mt-10 md:mt-14" aria-labelledby="bestuurders">
    <h2 id="bestuurders" class="mb-4 px-2 text-[28px] leading-tight font-extrabold md:mb-6 md:px-0 md:text-4xl">Bestuurders</h2>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {
        bestuurders.map((p) => (
          <li>
            <PersonCard {...p} />
          </li>
        ))
      }
    </ul>

    <h2 class="mt-10 mb-4 px-2 text-[28px] leading-tight font-extrabold md:mt-14 md:mb-6 md:px-0 md:text-4xl">Medewerkers</h2>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {
        medewerkers.map((p) => (
          <li>
            <PersonCard {...p} />
          </li>
        ))
      }
    </ul>

    <div class="mt-6 flex flex-col gap-4 rounded-card bg-accent-soft p-6 md:flex-row md:items-center md:justify-between md:p-8">
      <p class="max-w-[60ch] text-[17px] leading-normal">
        Wil je in het bestuur of help je liever mee als medewerker? Mail naar <a class="link" href={`mailto:${mail.secretariaat}`}>{mail.secretariaat}</a>.
      </p>
      <a href={u('/vacatures')} class="btn shrink-0 bg-ink text-white">Open vacatures</a>
    </div>
  </section>

  <section class="wrap mt-14 grid gap-10 md:mt-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,420px)] lg:gap-16">
    <div>
      <div class="prose-pbo px-2 md:px-0">
        <Content />
      </div>
      <table class="mt-4 w-full max-w-[680px] overflow-hidden rounded-card bg-paper text-left">
        <caption class="sr-only">Provinciale bijdrage per speler per jaar</caption>
        <thead>
          <tr class="label text-muted">
            <th scope="col" class="px-5 pt-5 pb-3 font-semibold md:px-6">Club</th>
            <th scope="col" class="px-5 pt-5 pb-3 font-semibold md:px-6">Per speler</th>
            <th scope="col" class="px-5 pt-5 pb-3 font-semibold md:px-6">Minimum</th>
          </tr>
        </thead>
        <tbody>
          {
            bijdragen.map((b) => (
              <tr class="border-t border-wash">
                <th scope="row" class="px-5 py-4 font-semibold md:px-6">{b.type}</th>
                <td class="num px-5 py-4 md:px-6">{b.perSpeler}</td>
                <td class="num px-5 py-4 md:px-6">{b.minimum}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="flex flex-col gap-3 lg:pt-1">
      <h2 class="sr-only">Documenten</h2>
      {documenten.map((d) => <LinkCard href={u(d.bestand)} icon="document" title={d.titel} text={d.tekst} />)}
      <p class="px-2 pt-1 text-[15px] leading-normal text-muted">
        Het intern reglement staat niet online. Leden vragen het op bij het secretariaat.
      </p>
    </div>
  </section>

  <section id="kalender" class="wrap mt-14 md:mt-20" aria-labelledby="kalender-titel">
    <div class="mb-4 px-2 md:mb-6 md:px-0">
      <h2 id="kalender-titel" class="text-[28px] leading-tight font-extrabold md:text-4xl">PBO-kalender</h2>
      <p class="mt-2 max-w-[60ch] text-muted">
        Trainingen van de PBO-selectie, vergaderingen en evenementen. De kalender verandert vaak, kijk dus even na voor je vertrekt.
      </p>
      <a href={pboKalenderEmbed} target="_blank" rel="noopener" class="mt-3 inline-flex min-h-11 items-center gap-2 font-semibold text-brand hover:underline">
        <Icon name="extern" size={18} stroke={2} /> Open in Google Agenda
        <span class="sr-only">(nieuw venster)</span>
      </a>
    </div>
    <div class="overflow-hidden rounded-card bg-paper p-2 md:p-3">
      <iframe
        src={pboKalenderEmbed}
        title="PBO-kalender (Google Agenda)"
        loading="lazy"
        class="block h-[560px] w-full rounded-2xl border-0 md:h-[640px]"></iframe>
    </div>
  </section>
</BaseLayout>
