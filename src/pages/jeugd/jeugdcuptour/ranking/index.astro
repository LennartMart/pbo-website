---
import { u } from '../../../../lib/url';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageIntro from '../../../../components/PageIntro.astro';
import RankingView from '../../../../components/RankingView.astro';
import RankingArchief from '../../../../components/RankingArchief.astro';
import { archief, komende, rankingJaar, rankingPerJaar, standNaZin, volgendeStandZin } from '../../../../lib/jeugdcup';

const jaren = await rankingPerJaar();
const [volgende] = await komende();
const recent = jaren[0];
const crumbs = [{ href: u('/jeugd'), label: 'Jeugd' }, { href: u('/jeugd/jeugdcuptour'), label: 'Jeugdcuptour' }, { label: 'Ranking' }];

// "Stand na BC De Mintons, zaterdag 26 september. De volgende stand komt na Gentse BC op 11 oktober."
const lead = [recent ? standNaZin(recent.laatste) : 'Er staat nog geen stand online.', volgende && volgendeStandZin(volgende, recent?.jaar)]
  .filter(Boolean)
  .join(' ');
---

<BaseLayout
  title="Ranking jeugdcuptour"
  description={recent
    ? `Stand van de Victor Jeugdcuptour by PBO na ${recent.laatste.club}, kalenderjaar ${recent.jaar}. Zoek je naam per categorie.`
    : 'Stand van de Victor Jeugdcuptour by PBO per categorie, jongens en meisjes apart.'}
>
  <PageIntro title={recent ? `Ranking ${recent.jaar}` : 'Ranking jeugdcuptour'} lead={lead} crumbs={crumbs} />
  {
    recent ? (
      <RankingView
        {...recent}
        jaren={jaren.map((j) => j.jaar)}
        nieuwste={recent.jaar}
        volgende={volgende && rankingJaar(volgende) === recent.jaar ? volgende : undefined}
      />
    ) : (
      <section class="wrap mt-8">
        <h2 class="mb-1 px-2 text-[28px] leading-tight font-extrabold md:px-0 md:text-4xl">Eerdere standen</h2>
        <p class="mb-5 px-2 text-muted md:px-0">De ranking loopt per kalenderjaar. In januari begint een nieuwe stand.</p>
        <RankingArchief items={archief.map((a) => ({ label: a.label, href: u(a.bestand), pdf: true }))} />
      </section>
    )
  }
</BaseLayout>
