---
import Periode from './Periode.astro';

interface Crumb {
  href?: string;
  label: string;
}

/** Een intro die van de datum afhangt: per periode (van, tot) een tekst, zoals Periode. */
interface Lead {
  tekst: string;
  van?: string;
  tot?: string;
}

interface Props {
  title: string;
  lead?: string | Lead[];
  crumbs?: Crumb[];
}

const { title, lead, crumbs } = Astro.props;
const leads = typeof lead === 'string' ? [{ tekst: lead }] : (lead ?? []);
---

<section class="wrap pt-4 md:pt-6">
  <div class="px-2 md:px-0">
    {
      crumbs && (
        <nav aria-label="Kruimelpad" class="mb-4 text-sm text-muted">
          <ol class="-ml-1 flex flex-wrap items-center gap-x-1">
            {crumbs.map((c, i) => (
              <li class="flex items-center gap-x-1">
                {i > 0 && <span aria-hidden="true">/</span>}
                {c.href ? (
                  <a href={c.href} class="inline-flex min-h-11 min-w-11 items-center justify-center px-1 hover:text-brand">
                    {c.label}
                  </a>
                ) : (
                  <span aria-current="page" class="px-1 font-semibold text-ink">
                    {c.label}
                  </span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <h1 class="text-[40px] leading-[1.05] font-extrabold tracking-[-0.02em] md:text-[52px] lg:text-[60px]">{title}</h1>
    {
      leads.map(({ tekst, van, tot }) => (
        <Periode as="p" van={van} tot={tot} class="mt-3 max-w-[640px] text-lg leading-[1.55] text-muted">
          {tekst}
        </Periode>
      ))
    }
    <slot />
  </div>
</section>
