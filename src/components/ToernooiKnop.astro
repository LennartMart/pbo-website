---
import Icon from './Icon.astro';
import Periode from './Periode.astro';
import { toernooiLinks, type Toernooipagina } from '../lib/toernooi';

/** Knop naar tournamentsoftware: inschrijven, wedstrijden of uitslagen, mee met de datum. Niets zonder toernooilink. */
interface Props {
  toernooi: Toernooipagina;
  /** Voor schermlezers, bv. "Uitslagen van Gentse BC". */
  wie: string;
  class: string;
  /** Grootte van het icoon: 20 op een knop, kleiner in een lijst. */
  icoon?: number;
}

const { toernooi, wie, class: klasse, icoon = 20 } = Astro.props;
---

{
  toernooiLinks(toernooi, wie).map(({ link, van, tot }) => (
    <Periode as="a" van={van} tot={tot} class={klasse} href={link.href} rel="noopener">
      <Icon name={link.icon} size={icoon} stroke={2} /> {link.label}
      <span class="sr-only"> {link.sr} (andere website)</span>
    </Periode>
  ))
}
