---
import { u } from '../lib/url';
import Icon from './Icon.astro';
import Beweging from './Beweging.astro';
import RankingArchief from './RankingArchief.astro';
import { mail } from '../data/site';
import { pagina } from '../lib/paginas';
import {
  bewegingen,
  categorieen,
  categorieLabel,
  geboortejaren,
  geboortejarenKort,
  geslachtLabel,
  geslachten,
  type Beweging as BewegingType,
  type Stand,
  type Toernooi,
} from '../lib/jeugdcup';
import { toonPunten, type Rij } from '../lib/stand';
import { compact } from '../lib/zoek';
import { dag, maand } from '../lib/datum';

interface Props {
  jaar: number;
  per: Map<string, Stand>;
  /** Stand van de halte ervoor, per categorie-geslacht, voor de plaatswinst. */
  vorige: Map<string, Stand>;
  laatste: Toernooi;
  voorbeeld: boolean;
  /** Andere jaren met data, nieuwste eerst. */
  jaren: number[];
  nieuwste: number;
  /** Volgende halte, voor "de volgende stand komt na ...". Enkel bij de lopende ranking. */
  volgende?: Toernooi;
}

const { jaar, per, vorige, laatste, voorbeeld, jaren, nieuwste, volgende } = Astro.props;

const { archief } = await pagina('jeugdcuptour');
const jaarHref = (j: number) => u(j === nieuwste ? '/jeugd/jeugdcuptour/ranking' : `/jeugd/jeugdcuptour/ranking/${j}`);
const anderen = [
  ...jaren.filter((j) => j !== jaar).map((j) => ({ label: `Ranking ${j}`, href: jaarHref(j) })),
  ...archief.map((a) => ({ label: a.label, href: u(a.bestand), pdf: true })),
];

const datum = (iso: string) => `${dag(iso)} ${maand(iso)}`;

// Eerste combinatie met data als startpunt (zonder JavaScript zie je alles onder elkaar).
const eerste = categorieen.flatMap((c) => geslachten.map((g) => `${c.id}-${g.id}`)).find((k) => per.has(k));

// Bewegingen per stand, en een kaart per speler voor het zoeken (naam + club).
const beweging = new Map([...per].map(([k, s]) => [k, bewegingen(s, vorige.get(k))]));
interface Lijn {
  key: string;
  cat: string;
  geslacht: string;
  rij: number;
  pos: number;
  punten: number;
  partners: string[];
  beweging?: BewegingType;
}
const spelers = new Map<string, { naam: string; club?: string; lijnen: Lijn[] }>();
for (const c of categorieen) {
  for (const g of geslachten) {
    const key = `${c.id}-${g.id}`;
    const s = per.get(key);
    if (!s) continue;
    s.rijen.forEach((r, i) => {
      for (const p of r.spelers) {
        const id = `${p.naam}|${p.club ?? ''}`.toLowerCase();
        const kaart = spelers.get(id) ?? { naam: p.naam, club: p.club, lijnen: [] };
        kaart.lijnen.push({
          key,
          cat: c.id,
          geslacht: g.id,
          rij: i,
          pos: r.pos,
          punten: r.punten,
          partners: r.spelers.filter((x) => x !== p).map((x) => x.naam),
          beweging: beweging.get(key)![i],
        });
        spelers.set(id, kaart);
      }
    });
  }
}
const kaarten = [...spelers.values()].sort((a, b) => a.naam.localeCompare(b.naam, 'nl'));

/** Podium: de eerste drie rijen (als ze in de top 3 staan). Rest gaat naar de tabel. */
const podiumVan = (s: Stand) => s.rijen.slice(0, 3).filter((r) => r.pos <= 3);
// Visuele volgorde 2-1-3, hoogte volgens de plaats op het podium (niet de positie: bij een gedeelde plaats blijft het podium leesbaar).
const podiumStijl = [
  { order: 'order-2', blok: 'h-28 bg-accent text-ink md:h-36' },
  { order: 'order-1', blok: 'h-[88px] bg-paper md:h-28' },
  { order: 'order-3', blok: 'h-[72px] bg-paper md:h-24' },
];
const clubs = (r: Rij) => [...new Set(r.spelers.map((p) => p.club).filter(Boolean))];

const metBeweging = (key: string) => vorige.has(key);
const chip =
  'flex min-h-[52px] min-w-0 flex-col items-center justify-center rounded-full border-[1.5px] border-edge bg-paper px-1 text-center leading-tight transition-colors hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-white sm:px-5';
const segment =
  'flex min-h-12 min-w-0 flex-col items-center justify-center rounded-full px-2 text-center leading-tight transition-colors hover:bg-paper/60 disabled:cursor-not-allowed disabled:text-muted disabled:hover:bg-transparent aria-pressed:bg-ink aria-pressed:text-white aria-pressed:hover:bg-ink';
---

<section class="wrap mt-6 md:mt-8">
  {
    voorbeeld && (
      <p class="mb-5 inline-flex items-center gap-2 rounded-full bg-accent-soft px-4 py-2 text-sm font-semibold text-brand">
        Testversie: verzonnen namen
      </p>
    )
  }

  <!-- Zoeken: de snelste weg voor wie een naam zoekt. Zonder JavaScript verborgen. -->
  <div data-zoekblok hidden class="px-2 md:px-0">
    <label for="zoek-naam" class="block font-display text-[22px] leading-tight font-bold md:text-2xl">Zoek je naam</label>
    <div class="relative mt-2.5 md:max-w-[560px]">
      <Icon name="zoek" size={20} stroke={2} class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-muted" />
      <input
        id="zoek-naam"
        type="search"
        enterkeyhint="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Voornaam, achternaam of club"
        aria-describedby="zoek-uitleg"
        class="min-h-[52px] w-full rounded-full border-[1.5px] border-edge bg-paper pr-4 pl-12 text-base placeholder:text-muted focus:border-ink"
      />
    </div>
    <p id="zoek-uitleg" class="mt-2 text-[15px] text-muted">Zoekt in alle categorieën van {jaar}.</p>
  </div>

  <!-- Zoekresultaten: één kaart per speler, met elke stand waarin die staat. -->
  <div data-resultaten hidden class="mt-6">
    <h2 class="sr-only">Zoekresultaten</h2>
    <div class="mb-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-2 md:px-0">
      <p data-zoekstatus class="font-semibold" aria-live="polite"></p>
      <button type="button" data-wis class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-brand hover:underline">
        <Icon name="sluit" size={18} stroke={2.2} /> Wis zoekopdracht
      </button>
    </div>

    <ul class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
      {
        kaarten.map((k) => (
          <li hidden data-kaart data-zoek={`${compact(k.naam)}|${compact(k.club ?? '')}`} class="rounded-card bg-paper p-5 md:p-6">
            <h3 class="font-display text-[22px] leading-tight font-bold">{k.naam}</h3>
            {k.club && <p class="mt-0.5 text-[15px] text-muted">{k.club}</p>}
            <ul class="mt-3">
              {k.lijnen.map((l) => (
                <li class="border-t border-wash">
                  <button type="button" data-naar={l.key} data-rij={l.rij} class="group flex min-h-16 w-full items-center gap-3 py-2.5 text-left">
                    <span class="num w-11 shrink-0 font-display text-[30px] leading-none font-extrabold">
                      <span class="sr-only">Plaats </span>
                      {l.pos}
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block font-semibold">
                        {categorieLabel(l.cat)} · {geslachtLabel(l.geslacht)}
                      </span>
                      <span class="block text-sm text-muted">
                        {toonPunten(l.punten)} punten{l.partners.length > 0 && ` · met ${l.partners.join(' en ')}`}
                      </span>
                    </span>
                    <Beweging waarde={l.beweging} class="shrink-0" />
                    <Icon name="pijl" size={18} stroke={2} class="shrink-0 text-brand transition-transform group-hover:translate-x-0.5" />
                    <span class="sr-only">, toon in de stand</span>
                  </button>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <div data-niets hidden class="rounded-card bg-paper p-6 md:p-8">
      <h3 class="font-display text-[22px] leading-tight font-bold">Niemand gevonden</h3>
      <ul class="mt-3 flex max-w-[62ch] list-disc flex-col gap-1.5 pl-5 leading-normal text-muted marker:text-brand">
        <li>Zoek op een deel van de naam, bijvoorbeeld enkel de voornaam of de club.</li>
        <li>
          In de ranking {jaar} staan alleen spelers die dit kalenderjaar al punten haalden. Deze stand is van na {laatste.club} ({datum(laatste.date)}).
        </li>
        {volgende && <li>De volgende stand komt na {volgende.club} op {datum(volgende.date)}.</li>}
      </ul>
      <p class="mt-5 leading-normal">Je speelde wel mee en je staat er niet in? Laat het ons weten, dan zoeken we het uit.</p>
      <a
        data-mail
        href={`mailto:${mail.jeugdcup}`}
        class="btn mt-4 w-full bg-ink text-white sm:w-auto"
        data-onderwerp={`Ranking ${jaar}: naam ontbreekt`}
      >
        <Icon name="mail" size={20} /> Mail {mail.jeugdcup}
      </a>
    </div>
  </div>
</section>

<!-- Stand per categorie, jongens en meisjes apart. De filterbalk blijft bovenaan staan tijdens het scrollen. -->
<section class="group/bord wrap mt-6 md:mt-10" data-bord data-start={eerste}>
  <div data-filterstart aria-hidden="true"></div>
  <div
    data-filters
    hidden
    class="sticky top-0 z-20 -mx-3 flex flex-col gap-2 bg-ground px-3 py-2.5 transition-shadow data-vast:shadow-[0_14px_24px_-20px_rgb(12_42_32/0.55)] md:-mx-8 md:px-8 md:py-3 lg:flex-row lg:items-center lg:justify-between lg:gap-6"
  >
    <div class="grid grid-cols-5 gap-1.5 sm:flex sm:gap-2" role="group" aria-label="Categorie">
      {
        categorieen.map((c) => (
          <button type="button" class={chip} data-cat={c.id} aria-pressed="false">
            <span class="text-[13px] font-bold min-[380px]:text-sm sm:text-[15px]">{c.label}</span>
            <span class="text-xs font-medium opacity-80">
              <span class="sr-only">geboren </span>
              {geboortejarenKort(c.id, jaar)}
            </span>
          </button>
        ))
      }
    </div>
    <div class="grid grid-cols-2 gap-1 rounded-full bg-wash p-1 sm:max-w-[420px] lg:w-[320px] lg:shrink-0" role="group" aria-label="Jongens of meisjes">
      {
        geslachten.map((g) => (
          <button type="button" class={segment} data-geslacht={g.id} aria-pressed="false">
            <span class="text-[15px] font-semibold">{g.label}</span>
            <span class="text-xs opacity-80" data-aantal-label />
          </button>
        ))
      }
    </div>
  </div>
  <p data-bordstatus class="sr-only" aria-live="polite"></p>

  <div class="mt-4 flex flex-col gap-12 md:mt-6">
    {
      categorieen.map((c) =>
        geslachten.map((g) => {
          const key = `${c.id}-${g.id}`;
          const s = per.get(key);
          if (!s)
            return (
              <div data-stand={key} data-aantal="0" class="scroll-mt-40">
                <h2 class="px-2 text-[22px] leading-tight font-bold md:px-1 md:text-[26px]">
                  {c.label} · {g.label}
                </h2>
                <p class="mt-3 rounded-card bg-paper p-6 leading-normal text-muted md:p-8">
                  Nog geen stand voor {c.label} {g.id} in {jaar}.
                  {volgende && ` De volgende stand komt na ${volgende.club} op ${datum(volgende.date)}.`}
                </p>
              </div>
            );
          const podium = podiumVan(s);
          const rest = s.rijen.slice(podium.length);
          const bew = beweging.get(key)!;
          return (
            <div data-stand={key} data-aantal={s.rijen.length} class="scroll-mt-40">
              <div class="px-2 md:px-1 max-md:group-data-js/bord:sr-only">
                <h2 id={`stand-${key}`} class="text-[22px] leading-tight font-bold md:text-[26px]">
                  {c.label} · {g.label}
                </h2>
                <p class="mt-1 text-[15px] text-muted">
                  Geboren in {geboortejaren(c.id, jaar)} · {s.rijen.length} {s.rijen.length === 1 ? 'speler' : 'spelers'}
                  {/* Enkel vermelden als deze stand van een andere halte is dan de rest (bovenaan de pagina). */}
                  {s.toernooi.id !== laatste.id && ` · stand na ${s.toernooi.club}, ${datum(s.toernooi.date)}`}
                </p>
              </div>

              <div class="mx-auto mt-4 max-w-[680px] md:mt-5">
              <ol class="grid grid-cols-3 items-end gap-2 md:gap-4" aria-label={`Podium ${c.label} ${g.id}`}>
                {podium.map((r, i) => (
                  <li class:list={['flex scroll-mt-48 flex-col rounded-[20px] transition-colors data-uitgelicht:bg-accent-soft', podiumStijl[i].order]} data-rij={i} tabindex="-1">
                    <div class="px-1 pt-2 pb-2.5 text-center">
                      {r.spelers.map((p) => (
                        <span class="block text-[15px] leading-snug font-semibold [overflow-wrap:anywhere] md:text-base">{p.naam}</span>
                      ))}
                      <span class="mt-0.5 block text-[13px] leading-snug text-muted md:text-sm">{clubs(r).join(' · ')}</span>
                      {bew[i] !== undefined && <Beweging waarde={bew[i]} class="mt-1 inline-flex" />}
                    </div>
                    <div class:list={['flex flex-col items-center rounded-t-[18px] pt-2.5 md:pt-3.5', podiumStijl[i].blok]}>
                      <span class="num font-display text-[40px] leading-none font-extrabold md:text-[52px]">
                        <span class="sr-only">Plaats </span>
                        {r.pos}
                      </span>
                      <span class="num mt-1 text-[13px] font-semibold md:text-sm">{toonPunten(r.punten)} punten</span>
                    </div>
                  </li>
                ))}
              </ol>
              <div class="h-[3px] rounded-full bg-ink" aria-hidden="true" />
              </div>

              {rest.length > 0 && (
                <div class="mt-4 rounded-card bg-paper p-2 md:p-3">
                  <table class="w-full text-left">
                    <caption class="sr-only">
                      {c.label} {g.id}, plaats {rest[0].pos} en verder, na {s.toernooi.club}, {jaar}
                    </caption>
                    <thead>
                      <tr class="label text-muted">
                        <th scope="col" class="w-12 px-3 pt-3 pb-3 font-semibold md:w-16 md:px-5">#</th>
                        <th scope="col" class="px-3 pt-3 pb-3 font-semibold md:px-5">Speler</th>
                        <th scope="col" class="hidden px-5 pt-3 pb-3 font-semibold sm:table-cell">Club</th>
                        <th scope="col" class="w-20 px-3 pt-3 pb-3 text-right font-semibold md:w-24 md:px-5">Punten</th>
                        {metBeweging(key) && (
                          <th scope="col" class="w-12 pt-3 pr-3 pb-3 text-right font-semibold md:w-16 md:pr-5">
                            <span aria-hidden="true">+/−</span>
                            <span class="sr-only">Sinds de vorige halte</span>
                          </th>
                        )}
                      </tr>
                    </thead>
                    <tbody>
                      {rest.map((r, j) => {
                        const i = podium.length + j;
                        return (
                          <tr class="scroll-mt-48 border-t border-wash transition-colors data-uitgelicht:bg-accent-soft" data-rij={i} tabindex="-1">
                            <td class="num px-3 py-3.5 align-baseline font-display text-2xl leading-none font-extrabold md:px-5">{r.pos}</td>
                            <td class="px-3 py-3.5 align-baseline md:px-5">
                              {r.spelers.map((p) => (
                                <span class="block font-semibold">
                                  {p.naam}
                                  <span class="block text-sm font-normal text-muted sm:hidden">{p.club}</span>
                                </span>
                              ))}
                            </td>
                            <td class="hidden px-5 py-3.5 align-baseline text-muted sm:table-cell">
                              {clubs(r).length === 1 ? clubs(r)[0] : r.spelers.map((p) => <span class="block">{p.club}</span>)}
                            </td>
                            <td class="num px-3 py-3.5 text-right align-baseline font-semibold md:px-5">{toonPunten(r.punten)}</td>
                            {metBeweging(key) && (
                              <td class="py-3.5 pr-3 text-right align-baseline md:pr-5">
                                <Beweging waarde={bew[i]} />
                              </td>
                            )}
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              )}

              <div class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-2 text-[15px] text-muted md:px-1">
                {metBeweging(key) && <span>Pijltjes: plaatsen gestegen of gedaald sinds {vorige.get(key)!.toernooi.club}.</span>}
                {s.pdf && (
                  <a href={u(s.pdf)} class="inline-flex min-h-11 items-center gap-2 font-semibold text-brand hover:underline">
                    <Icon name="document" size={20} /> Download als pdf
                  </a>
                )}
              </div>
            </div>
          );
        }),
      )
    }
  </div>
</section>

<section class="wrap mt-14 md:mt-16">
  {
    anderen.length > 0 && (
      <>
        <h2 class="mb-1 px-2 text-[28px] leading-tight font-extrabold md:px-0 md:text-4xl">Eerdere standen</h2>
        <p class="mb-5 px-2 text-muted md:px-0">De ranking loopt per kalenderjaar. In januari begint een nieuwe stand.</p>
        <RankingArchief items={anderen} />
      </>
    )
  }
  <p class="mt-8 max-w-[640px] px-2 leading-normal text-muted md:px-0">
    Klopt er iets niet? Mail naar <a class="link" href={`mailto:${mail.jeugdcup}`}>{mail.jeugdcup}</a> en we passen het aan.
  </p>
</section>

<script>
  import { woorden } from '../lib/zoek';

  const bord = document.querySelector<HTMLElement>('[data-bord]');
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const filterstart = document.querySelector<HTMLElement>('[data-filterstart]');
  const bordstatus = document.querySelector<HTMLElement>('[data-bordstatus]');
  const zoekblok = document.querySelector<HTMLElement>('[data-zoekblok]');
  const zoek = document.querySelector<HTMLInputElement>('#zoek-naam');
  const resultaten = document.querySelector<HTMLElement>('[data-resultaten]');
  const status = document.querySelector<HTMLElement>('[data-zoekstatus]');
  const niets = document.querySelector<HTMLElement>('[data-niets]');
  const mailKnop = document.querySelector<HTMLAnchorElement>('[data-mail]');

  if (bord && filters && filterstart && bordstatus && zoekblok && zoek && resultaten && status && niets && mailKnop) {
    const standen = [...bord.querySelectorAll<HTMLElement>('[data-stand]')];
    const kaarten = [...resultaten.querySelectorAll<HTMLElement>('[data-kaart]')];
    const catKnoppen = [...filters.querySelectorAll<HTMLButtonElement>('[data-cat]')];
    const geslachtKnoppen = [...filters.querySelectorAll<HTMLButtonElement>('[data-geslacht]')];
    const stand = (cat: string, geslacht: string) => standen.find((s) => s.dataset.stand === `${cat}-${geslacht}`);
    const aantal = (cat: string, geslacht: string) => Number(stand(cat, geslacht)?.dataset.aantal ?? 0);
    const rustig = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SLEUTEL = 'pbo-ranking-keuze';

    // Startkeuze: link (?cat=&geslacht=) > vorige keer op dit toestel > eerste stand met data.
    const params = new URLSearchParams(location.search);
    let bewaard: { cat?: string; geslacht?: string } = {};
    try {
      bewaard = JSON.parse(localStorage.getItem(SLEUTEL) ?? '{}');
    } catch {}
    const [startCat, startGeslacht] = (bord.dataset.start ?? 'u13-jongens').split(/-(?=jongens|meisjes)/);
    const geldig = (cat?: string | null, geslacht?: string | null) => !!cat && !!geslacht && !!stand(cat, geslacht);
    let [cat, geslacht] = geldig(params.get('cat'), params.get('geslacht'))
      ? [params.get('cat')!, params.get('geslacht')!]
      : geldig(bewaard.cat, bewaard.geslacht)
        ? [bewaard.cat!, bewaard.geslacht!]
        : [startCat, startGeslacht];

    /** Bij een andere categorie: blijf bij jongens of meisjes als daar een stand is, anders het andere. */
    function kiesCategorie(nieuw: string) {
      cat = nieuw;
      if (aantal(cat, geslacht) === 0) geslacht = geslachtKnoppen.map((b) => b.dataset.geslacht!).find((d) => aantal(cat, d) > 0) ?? geslacht;
    }

    function toonBord() {
      catKnoppen.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
      for (const b of geslachtKnoppen) {
        const d = b.dataset.geslacht!;
        const n = aantal(cat, d);
        b.setAttribute('aria-pressed', String(d === geslacht));
        b.disabled = n === 0 && d !== geslacht;
        b.querySelector('[data-aantal-label]')!.textContent = n === 0 ? 'nog geen stand' : `${n} ${n === 1 ? 'speler' : 'spelers'}`;
      }
      standen.forEach((s) => (s.hidden = s.dataset.stand !== `${cat}-${geslacht}`));
      standen.forEach((s) => s.querySelectorAll('[data-uitgelicht]').forEach((el) => el.removeAttribute('data-uitgelicht')));
    }

    function bewaar() {
      const url = new URL(location.href);
      url.searchParams.set('cat', cat);
      url.searchParams.set('geslacht', geslacht);
      url.searchParams.delete('q');
      history.replaceState(null, '', url);
      try {
        localStorage.setItem(SLEUTEL, JSON.stringify({ cat, geslacht }));
      } catch {}
    }

    /** Na een keuze: staat de stand niet (helemaal) in beeld, scroll dan tot net onder de filterbalk. */
    function brengInBeeld() {
      const vast = filterstart!.getBoundingClientRect().top < 0;
      const bordTop = stand(cat, geslacht)?.getBoundingClientRect().top ?? 0;
      if (vast || bordTop > innerHeight - 160) filterstart!.scrollIntoView({ behavior: rustig ? 'auto' : 'smooth', block: 'start' });
    }

    function kondig() {
      const s = stand(cat, geslacht);
      const n = Number(s?.dataset.aantal ?? 0);
      const naam = `${catKnoppen.find((b) => b.dataset.cat === cat)?.querySelector('span')?.textContent} ${geslacht}`;
      bordstatus!.textContent = n === 0 ? `${naam}: nog geen stand.` : `${naam}: ${n} ${n === 1 ? 'speler' : 'spelers'}.`;
    }

    filters.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!b || b.disabled) return;
      if (b.dataset.cat) kiesCategorie(b.dataset.cat);
      if (b.dataset.geslacht) geslacht = b.dataset.geslacht;
      toonBord();
      bewaar();
      kondig();
      brengInBeeld();
    });

    // Schaduw onder de filterbalk zodra die bovenaan blijft plakken.
    new IntersectionObserver(([e]) => filters.toggleAttribute('data-vast', !e.isIntersecting && e.boundingClientRect.top < 0)).observe(filterstart);

    // ---------------------------------------------------------------- zoeken

    function zoekNu() {
      const q = zoek!.value.trim();
      const delen = woorden(q);
      const actief = q.length >= 2 && delen.length > 0;
      bord!.hidden = actief;
      resultaten!.hidden = !actief;
      if (!actief) {
        status!.textContent = '';
        return;
      }
      let gevonden = 0;
      for (const k of kaarten) {
        const raak = delen.every((w) => k.dataset.zoek!.includes(w));
        k.hidden = !raak;
        if (raak) gevonden++;
      }
      niets!.hidden = gevonden > 0;
      status!.textContent = gevonden === 0 ? `Niemand gevonden voor "${q}".` : `${gevonden} ${gevonden === 1 ? 'speler' : 'spelers'} gevonden voor "${q}"`;
      const onderwerp = mailKnop!.dataset.onderwerp ?? '';
      mailKnop!.href = `mailto:${mailKnop!.href.replace(/^mailto:/, '').split('?')[0]}?subject=${encodeURIComponent(onderwerp)}&body=${encodeURIComponent(`Naam: ${q}\nClub:\nCategorie:\nGespeeld op (halte):\n`)}`;
    }

    let wacht: number | undefined;
    zoek.addEventListener('input', () => {
      zoekNu();
      // Zoekterm in de link, zodat je ze kunt delen. Even wachten zodat de geschiedenis niet bij elke letter verandert.
      clearTimeout(wacht);
      wacht = window.setTimeout(() => {
        const url = new URL(location.href);
        const q = zoek.value.trim();
        if (q.length >= 2) url.searchParams.set('q', q);
        else url.searchParams.delete('q');
        history.replaceState(null, '', url);
      }, 400);
    });
    // Enter sluit het toetsenbord op de telefoon, zodat de resultaten in beeld komen.
    zoek.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') zoek.blur();
    });

    resultaten.querySelector('[data-wis]')!.addEventListener('click', () => {
      zoek.value = '';
      zoekNu();
      bewaar();
      zoek.focus();
    });

    // Van een spelerkaart naar de juiste stand, met de rij uitgelicht.
    resultaten.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-naar]');
      if (!b) return;
      [cat, geslacht] = b.dataset.naar!.split(/-(?=jongens|meisjes)/);
      zoek.value = '';
      zoekNu();
      toonBord();
      bewaar();
      kondig();
      const rij = stand(cat, geslacht)?.querySelector<HTMLElement>(`[data-rij="${b.dataset.rij}"]`);
      if (rij) {
        rij.setAttribute('data-uitgelicht', '');
        rij.scrollIntoView({ behavior: rustig ? 'auto' : 'smooth', block: 'center' });
        rij.focus({ preventScroll: true });
      }
    });

    zoekblok.hidden = false;
    filters.hidden = false;
    // Op de telefoon tonen de filters al categorie, geboortejaren en aantal: de kop boven de stand mag dan weg.
    bord.toggleAttribute('data-js', true);
    toonBord();
    const q = params.get('q');
    if (q) {
      zoek.value = q;
      zoekNu();
    }
  }
</script>
