---
import { u } from '../lib/url';
import { categorieNaam, type Bericht } from '../lib/nieuws';
import { lang } from '../lib/datum';

interface Props {
  bericht: Bericht;
}

const { bericht: b } = Astro.props;
---

<a href={u(`/nieuws/${b.id}`)} class="lift flex h-full flex-col gap-3 rounded-card bg-paper p-6 md:p-7">
  <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-bold tracking-[0.06em] text-brand uppercase">
      {categorieNaam(b.data.category)}
    </span>
    <time datetime={b.data.date} class="text-sm text-muted">{lang(b.data.date)}</time>
  </span>
  <h3 class="font-display text-[21px] leading-[1.2] font-bold md:text-[23px]">{b.data.title}</h3>
  <p class="leading-normal text-muted">{b.data.excerpt}</p>
</a>
